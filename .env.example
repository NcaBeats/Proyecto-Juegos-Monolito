# Plantilla de variables de entorno del backend.
# Copiar a .env y completar.  NUNCA versionar .env
#
# Este archivo documenta QUE hace cada variable y de donde sale su valor en
# produccion. Los valores de produccion NO van aqui: van en el panel de
# Render, que es el almacen de secretos. Ver README > Despliegue.
#
# Convencion de nombres, el prefijo indica quien es el dueno:
#   SPRING_*  el framework   APP_*  la app   (sin prefijo)  un proveedor
#
# Generar APP_JWT_SECRET (PowerShell, 64 bytes aleatorios en base64):
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $bytes = New-Object byte[] 64
#   $rng.GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)

# --- Base de datos ---
# Conexion a Postgres. En local apunta a tu maquina; docker compose lo
# sobrescribe con el host "postgres", porque dentro de la red del contenedor
# el host es el nombre del servicio y no localhost.
# En prod: panel de Render > tu base > Internal DB URL, en formato JDBC.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/proyecto_juegos
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Autenticacion ---
# Clave con la que se firman los JWT (HS256). Minimo 256 bits.
# El valor de prod DEBE ser distinto al de local: si se filtran las claves
# de esta maquina, no pueden abrir la produccion.
APP_JWT_SECRET=
# Vigencia del token en milisegundos. 3600000 = 1 hora.
APP_JWT_EXPIRATION=3600000

# --- Cloudflare R2: TODA la media (imagenes, trailers, portadas blog) ---
# Cloudinary ya no se usa (CLOUDINARY_URL es legacy, se puede borrar).
# El navegador sube el archivo directo con una URL firmada (PUT, 15 min).
# En prod: dashboard de Cloudflare > R2 > Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trailers

# --- Media normalizacion (one-shot runner) ---
# Ejecuta MediaUrlNormalizer al arranque: reescribe URLs legacy a absolutas
# contra R2_PUBLIC_BASE_URL. Solo para bases migradas; en prod default false.
APP_MEDIA_NORMALIZE_ENABLED=false

# --- CORS ---
# Origenes del navegador autorizados a llamar a la API, separados por comas y
# SIN barra final (el encabezado Origin nunca la lleva). allowCredentials esta
# activo, asi que "*" no es valido: la lista tiene que ser explicita.
# Local: localhost + IP LAN de tu Wi-Fi (cambia 192.168.100.64 por la tuya).
# En prod: dominio fijo de Vercel + wildcard de previews.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.100.64:3000,https://steam-clone-*.vercel.app
