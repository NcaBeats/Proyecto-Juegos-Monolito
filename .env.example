# Plantilla de variables de entorno.
# Copiar a .env y completar con los valores reales.  NUNOA versionar .env
#
# Generar KEY_JWT_SECRET (PowerShell, 64 bytes aleatorios en base64):
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $bytes = New-Object byte[] 64
#   $rng.GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
#
# CORS_ALLOWED_ORIGINS: lista separada por comas, SIN barra final.
# El encabezado Origin del navegador nunca lleva barra, por eso no debe
# ponerse. Solo el dominio de produccion; los previews de Vercel se
# agrega uno por uno si hacen falta.

# --- Base de datos (solo desarrollo local) ---
DB_NAME=proyecto_juegos
DB_USER=nico
DB_PASSWORD=

# --- Autenticacion ---
KEY_JWT_SECRET=
KEY_JWT_EXPIRATION=3600000

# --- Cloudinary (imagenes de juegos y categorias) ---
# Formato: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=

# --- Cloudflare R2 (trailers) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trailers
R2_PUBLIC_BASE_URL=https://pub-58f3bb038ab8451e96fb292f7cb1dc15.r2.dev

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://steam-clone-nine.vercel.app
